# Configuration WebSocket pour la production
# 
# Option 1: Si le serveur WebSocket est accessible sur le même domaine via un proxy
#           (nginx redirige /ws vers localhost:8080)
VITE_WS_URL=wss://votre-domaine.com/ws

# Option 2: Si le serveur WebSocket est accessible directement sur un port personnalisé
#           (Attention: doit être exposé publiquement)
# VITE_WS_URL=wss://votre-domaine.com:8080

# Option 3: Port personnalisé du serveur WebSocket
#           (par défaut: 8080)
# VITE_WS_PORT=8080
